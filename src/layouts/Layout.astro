<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>スムーススクロール反転テスト</title>
  <style>
    body {
      margin: 0;
      font-family: sans-serif;
    }
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 60px;
      line-height: 60px;
      background: #333;
      color: #fff;
      text-align: center;
      z-index: 1000;
    }
    main {
      margin-top: 60px;
    }
    section {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      border-bottom: 1px solid #ccc;
    }
    /* 回転モード */
    body.is-reverse {
      transform: rotate(-180deg);
    }
    body.is-reverse section {
      transform: rotate(-180deg);
    }
    .btns {
      margin-top: 10px;
    }
    .btns button, .btns a {
      margin: 5px;
      padding: 8px 12px;
      background: #0077cc;
      color: #fff;
      text-decoration: none;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
  </style>
</head>
<body id="body" class="is-reverse">
  <header>
    スクロールテスト
    <div class="btns">
      <button id="toggle-reverse">回転・提示切替</button>
      <a href="#section3">#section3へ移動</a>
      <a href="#section5">#section5へ移動</a>
    </div>
  </header>

  <main>
    <section id="section1">Section 1</section>
    <section id="section2">Section 2</section>
    <section id="section3">Section 3</section>
    <section id="section4">Section 4</section>
    <section id="section5">Section 5</section>
  </main>

 
</body>
</html>
